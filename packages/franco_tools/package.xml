<?xml version="1.0"?>
<package format="3">
  <name>franco_tools</name>
  <version>0.1.0</version>
  <description>Camera preview and bench command monitor.</description>
  <maintainer email="darionapo2.0@gmail.com">Dario Napolitano</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>franco_diagnostics</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
